# ---------------------------------------------------------------------------
# MultiBatch replication package -- build hygiene
# ---------------------------------------------------------------------------
# This package ships exactly what the manuscript, the Online Resources and the
# pipeline in run_all.py need: results/, figures/, supplementary/, scripts/,
# refs.bib, the class files and requirements.txt.  The rules below keep the
# local working tree (data, build products, draft sources, scratch files) out
# of the published history.
# ---------------------------------------------------------------------------

# --- data: never redistributed (see README, Data Availability) ---
data/

# --- manuscript sources and submission packages (submission-only) ---
manuscript.tex
manuscript.pdf
manuscript.bbl
manuscript.blg
cover_letter.tex
cover_letter.pdf
supplementary_figures.pdf
VALUE_STATEMENT.md
*.zip
*_Upload/
*_Scope_Check/

# --- internal working notes ---
*_AUDIT*.md
*_CHECKLIST.md
*_COMPLIANCE.md
REVIEW_*.md
FIGURE_AUDIT.md

# --- scratch, archives, tooling caches ---
_archive/
_scratch/
_rep_check/
_zipcheck/
.playwright-cli/
__pycache__/
*.pyc
.DS_Store

# --- LaTeX build products ---
*.aux
*.log
*.out
*.toc
*.synctex.gz

# --- backups ---
*.bak
*.bak_*
*.prev
*_old.*

# --- root-level probe scripts and logs ---
/_*.txt
/_*.py

# --- result caches that are rebuilt rather than shipped ---
# 46 MB expression cache; _prep_fig1_landscape.py rebuilds it from the TCGA files
results/_fig1_landscape.npz

# --- figures superseded by the current numbering ---
# Fig 2-5 of the pre-submission set; the artwork now uses Fig1-Fig9 for the manuscript,
# numbered in the order the text first cites them, and FigS1-FigS4 for the supplementary
# figures (so fig1_synthetic is FigS2 and fig4_sensitivity is FigS1)
figures/fig2_tcga.*
figures/fig3_baselines.*
figures/fig5_biological_validation.*
# the 11 single-gene Kaplan-Meier panels superseded by Figure 5, listed by name
# on purpose: a wildcard is unsafe here, because core.ignorecase makes the
# character class match lowercase too and would swallow km_brca_panel as well
figures/km_ADH1B.png
figures/km_ADIPOQ.png
figures/km_CEACAM5.png
figures/km_COL17A1.png
figures/km_CST1.png
figures/km_KLK6.png
figures/km_KRT5.png
figures/km_NAT1.png
figures/km_NKAIN1.png
figures/km_SCGB2A2.png
figures/km_TFF1.png
figures/km_ADH1B.pdf
figures/km_ADIPOQ.pdf
figures/km_CEACAM5.pdf
figures/km_COL17A1.pdf
figures/km_CST1.pdf
figures/km_KLK6.pdf
figures/km_KRT5.pdf
figures/km_NAT1.pdf
figures/km_NKAIN1.pdf
figures/km_SCGB2A2.pdf
figures/km_TFF1.pdf

# --- analyses that are not part of the manuscript or the Online Resources ---
# drug-sensitivity screen and single-cell layer, kept locally for future work
figures/fig_drug.*
figures/fig_singlecell.*
figures/_canvas_check.txt
scripts/figures/gen_fig_drug_sensitivity.py
scripts/figures/gen_fig_singlecell.py
results/_drug_sensitivity.json
results/_cancer_sea_control.json
results/_cancer_sea_hubs.json
results/_fig_sc_landscape.json
results/_hpa_celltype.npz
results/_single_cell_layer_stats.json
