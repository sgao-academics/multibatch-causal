# Keep line endings identical on every platform, so that the SHA-256 manifest
# in SHA256SUMS.txt verifies against the bytes a reader actually receives.
# Without this, core.autocrlf rewrites text files to CRLF on checkout and every
# digest in the manifest fails.
* text=auto eol=lf

# Binary assets -- never touched.
*.png   binary
*.pdf   binary
*.xlsx  binary
*.npz   binary
*.npy   binary
*.gz    binary
*.zip   binary
*.pkl   binary
